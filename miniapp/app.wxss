page {
    min-height: 100%;
    background: #f4f6f8;
    color: #1f2329;
    font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", sans-serif;
    font-size: 28rpx;
}

button {
    border-radius: 12rpx;
}

button::after {
    border: none;
}

/* ---------- 通用布局 ---------- */
.page {
    box-sizing: border-box;
    min-height: 100vh;
    padding: 32rpx 32rpx 64rpx;
}

.card {
    box-sizing: border-box;
    margin-bottom: 24rpx;
    padding: 32rpx;
    border: 2rpx solid #e8ebef;
    border-radius: 24rpx;
    background: #ffffff;
}

.card-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20rpx;
    font-size: 30rpx;
    font-weight: 600;
}

.card-title-extra {
    color: #8f959e;
    font-size: 24rpx;
    font-weight: 400;
}

.muted {
    color: #8f959e;
}

.mono {
    font-family: Menlo, Consolas, monospace;
    word-break: break-all;
}

/* ---------- 按钮 ---------- */
.btn-primary {
    background: #07c160;
    color: #ffffff;
    font-size: 30rpx;
    font-weight: 600;
}

.btn-primary[disabled] {
    background: #9fdfbd !important;
    color: #ffffff !important;
}

.btn-ghost {
    background: #f2f3f5;
    color: #1f2329;
    font-size: 28rpx;
}

/* ---------- 状态徽标 ---------- */
.badge {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
    padding: 4rpx 16rpx;
    border-radius: 999rpx;
    font-size: 22rpx;
    font-weight: 400;
    line-height: 1.6;
}

.badge-dot {
    width: 12rpx;
    height: 12rpx;
    margin-right: 8rpx;
    border-radius: 50%;
}

.badge-ok { background: #e8f8ef; color: #058a45; }
.badge-ok .badge-dot { background: #07c160; }
.badge-muted { background: #f2f3f5; color: #646a73; }
.badge-muted .badge-dot { background: #a8adb4; }
.badge-danger { background: #fdecec; color: #d83931; }
.badge-danger .badge-dot { background: #f54a45; }
.badge-warn { background: #fff4e5; color: #c46a00; }
.badge-warn .badge-dot { background: #ff8800; }

/* ---------- 24h 窗口进度条 ---------- */
.window-bar {
    overflow: hidden;
    height: 10rpx;
    margin-top: 12rpx;
    border-radius: 999rpx;
    background: #eef0f2;
}

.window-fill {
    height: 100%;
    border-radius: 999rpx;
}

.window-fill-ok { background: #07c160; }
.window-fill-warn { background: #ff8800; }
.window-fill-danger { background: #f54a45; }
.window-fill-muted { background: #c9cdd4; }

.text-ok { color: #058a45; }
.text-warn { color: #c46a00; }
.text-danger { color: #d83931; }
.text-muted { color: #8f959e; }

/* ---------- 三态 ---------- */
.state-box {
    display: flex;
    min-height: 360rpx;
    align-items: center;
    flex-direction: column;
    justify-content: center;
    padding: 48rpx 32rpx;
    text-align: center;
}

.state-icon {
    color: #07c160;
    font-size: 64rpx;
    font-weight: 700;
}

.state-title {
    margin-top: 16rpx;
    font-size: 32rpx;
    font-weight: 600;
}

.state-desc {
    margin-top: 12rpx;
    color: #646a73;
    font-size: 26rpx;
    line-height: 1.6;
}

.state-action {
    margin-top: 32rpx;
}

.spinner {
    width: 48rpx;
    height: 48rpx;
    border: 6rpx solid #d7f3e3;
    border-top-color: #07c160;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
}

@keyframes spin {
    to { transform: rotate(360deg); }
}

/* ---------- 键值行 ---------- */
.kv {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    padding: 18rpx 0;
    border-top: 2rpx solid #f2f3f5;
}

.kv-first {
    border-top: none;
}

.kv-key {
    flex-shrink: 0;
    width: 200rpx;
    color: #8f959e;
}

.kv-val {
    flex: 1;
    text-align: right;
    word-break: break-all;
}

/* ---------- 演示模式提示 ---------- */
.demo-banner {
    margin-bottom: 24rpx;
    padding: 16rpx 24rpx;
    border-radius: 16rpx;
    background: #fff4e5;
    color: #c46a00;
    font-size: 24rpx;
    line-height: 1.5;
}
