.profile {
    display: flex;
    align-items: center;
}

.avatar {
    display: flex;
    width: 96rpx;
    height: 96rpx;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: #07c160;
    color: #ffffff;
    font-size: 40rpx;
    font-weight: 600;
}

.profile-main {
    display: flex;
    flex: 1;
    flex-direction: column;
    margin-left: 24rpx;
    min-width: 0;
}

.profile-name {
    font-size: 34rpx;
    font-weight: 600;
}

.profile-sub {
    margin-top: 6rpx;
    color: #8f959e;
    font-size: 24rpx;
}

.link-danger {
    padding: 12rpx 0 12rpx 24rpx;
    color: #d83931;
    font-size: 26rpx;
}

.stats {
    display: flex;
    padding: 28rpx 8rpx;
}

.stat {
    display: flex;
    flex: 1;
    align-items: center;
    flex-direction: column;
}

.stat-num {
    font-size: 40rpx;
    font-weight: 700;
}

.stat-label {
    margin-top: 6rpx;
    color: #8f959e;
    font-size: 22rpx;
}

.section-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin: 16rpx 8rpx 20rpx;
}

.section-title {
    font-size: 30rpx;
    font-weight: 600;
}

.section-action {
    color: #07c160;
    font-size: 26rpx;
    font-weight: 600;
}

.bot-card-hover {
    background: #fafbfc;
}

.bot-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
}

.bot-title {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-width: 0;
    margin-right: 16rpx;
}

.bot-name {
    overflow: hidden;
    font-size: 32rpx;
    font-weight: 600;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.bot-id {
    margin-top: 6rpx;
    color: #a8adb4;
    font-size: 22rpx;
}

.bot-meta {
    display: flex;
    flex-wrap: wrap;
    margin-top: 20rpx;
    color: #646a73;
    font-size: 24rpx;
}

.dot-sep {
    margin: 0 10rpx;
    color: #c9cdd4;
}

.bot-window {
    margin-top: 20rpx;
}

.bot-window-row {
    display: flex;
    justify-content: space-between;
    font-size: 24rpx;
}

.bot-warn {
    display: block;
    margin-top: 16rpx;
    padding: 12rpx 16rpx;
    border-radius: 12rpx;
    background: #fff4e5;
    color: #c46a00;
    font-size: 22rpx;
    line-height: 1.5;
}
