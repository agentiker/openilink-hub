.intro {
    display: flex;
    flex-direction: column;
    margin: 16rpx 8rpx 32rpx;
}

.intro-title {
    font-size: 44rpx;
    font-weight: 700;
}

.intro-desc {
    margin-top: 12rpx;
    color: #646a73;
    font-size: 26rpx;
    line-height: 1.6;
}

.qr-card {
    display: flex;
    align-items: center;
    flex-direction: column;
    padding: 48rpx 32rpx 36rpx;
}

.qr-box {
    position: relative;
    width: 440rpx;
    height: 440rpx;
    border: 2rpx solid #eef0f2;
    border-radius: 20rpx;
    overflow: hidden;
    background: #ffffff;
}

.qr-img {
    width: 100%;
    height: 100%;
}

.qr-dim {
    opacity: 0.12;
}

.qr-placeholder {
    display: flex;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    background: #f7f8fa;
}

.qr-err-icon {
    font-size: 72rpx;
    font-weight: 700;
}

.qr-overlay {
    position: absolute;
    top: 0;
    left: 0;
    display: flex;
    width: 100%;
    height: 100%;
    align-items: center;
    flex-direction: column;
    justify-content: center;
}

.overlay-icon {
    display: flex;
    width: 112rpx;
    height: 112rpx;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: #07c160;
    color: #ffffff;
    font-size: 60rpx;
    font-weight: 700;
}

.overlay-text {
    margin-top: 16rpx;
    color: #058a45;
    font-size: 30rpx;
    font-weight: 600;
}

.status-row {
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 32rpx;
    min-height: 44rpx;
}

.spinner-sm {
    width: 28rpx;
    height: 28rpx;
    margin-right: 12rpx;
    border-width: 4rpx;
}

.status-text {
    font-size: 28rpx;
    text-align: center;
}

.refresh-btn {
    width: 360rpx !important;
    margin-top: 28rpx;
}

.qr-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 28rpx;
}

.qr-action {
    padding: 8rpx 12rpx;
    color: #07c160;
    font-size: 26rpx;
}

.qr-action-sep {
    color: #dcdfe3;
    font-size: 22rpx;
}

.tips-title {
    display: block;
    margin-bottom: 12rpx;
    font-size: 28rpx;
    font-weight: 600;
}

.tip {
    display: flex;
    align-items: flex-start;
    padding: 12rpx 0;
}

.tip-no {
    display: flex;
    width: 36rpx;
    height: 36rpx;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    margin-top: 4rpx;
    border-radius: 50%;
    background: #e8f8ef;
    color: #058a45;
    font-size: 22rpx;
}

.tip-text {
    margin-left: 16rpx;
    color: #646a73;
    font-size: 26rpx;
    line-height: 1.6;
}
