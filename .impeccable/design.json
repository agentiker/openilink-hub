    "rules": [
      {
        "name": "The Earned Green Rule",
        "section": "colors",
        "body": "Green means \"this is live right now\". Decorative green, green buttons, green headings: never."
      },
      {
        "name": "The One Ink Rule",
        "section": "colors",
        "body": "Primary actions are ink, not brand colour. One ink button per view; everything else is bordered or ghost."
      },
      {
        "name": "The Tabular Rule",
        "section": "typography",
        "body": "Every time, count, quota and ID renders with tabular numerals."
      },
      {
        "name": "The No-Eyebrow Rule",
        "section": "typography",
        "body": "Headings carry their own weight; no kicker or eyebrow label above them."
      },
      {
        "name": "The Hairline-First Rule",
        "section": "elevation",
        "body": "Separate with a 1px hairline before reaching for a shadow; shadows never carry state."
      }
